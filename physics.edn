;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a workshop scheduling/logistics coordination
;; robot schedules the cutting crew, logs patterns/progress and coordinates
;; fabric/pattern-materials supply; it never cuts. Its physical work is moving
;; heavy fabric rolls from the roll store to the spreading table and moving cut
;; bundles off the cutting table.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7532"
 :cases
 [{:id :fabric-roll-to-spreader
   :kind :transport
   :procedure "roll carrier brings full fabric rolls lying horizontally from the roll store to the spreading table"
   :params {:mass-kg 70.0 :distance-m 45.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.0 :drive-force-n 180.0 :crr 0.02
            :cog-height-m 0.30 :payload-cog-height-m 0.70 :support-half-length-m 0.35
            :max-time-s 1200.0}
   :sweep {:param :payload-kg :values [40.0 80.0 150.0 250.0 400.0]}
   :quantity :cycle-time-s
   :limit {:max 60.0 :basis "estimate: one roll delivery must fit inside a spread cycle so the spreading table does not wait"}
   :boundary {:lo 20.0 :hi 800.0}}
  {:id :cut-bundle-off-table
   :kind :manipulator
   :procedure "arm lifts a tied bundle of cut pieces from the cutting table into a bundle cart"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.80 0.00] :to [0.30 -0.20] :duration-s 2.0 :steps 400}
   :sweep {:param :payload-kg :values [1.0 3.0 5.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 120.0 :basis "estimate: continuous shoulder torque of a ~10 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}]}
